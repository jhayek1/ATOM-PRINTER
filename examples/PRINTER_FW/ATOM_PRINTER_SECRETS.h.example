// Copy to ATOM_PRINTER_SECRETS.h (ignored by git) and fill in your broker.
// Any MQTT broker with username/password and TLS works, e.g. the free tiers of
// HiveMQ Cloud or EMQX Serverless. Use the same values in the bot's environment.
#define MQTT_BROKER   "xxxxxxxx.s1.eu.hivemq.cloud"
#define MQTT_PORT     8883  // TLS
#define MQTT_USER     "printer"
#define MQTT_PASSWORD "change-me"

// Optional: the broker's root CA certificate (PEM). Without it the connection
// is still encrypted, but the broker's identity isn't verified.
// #define MQTT_ROOT_CA "-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
