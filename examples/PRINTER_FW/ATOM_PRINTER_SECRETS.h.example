// Copy to ATOM_PRINTER_SECRETS.h (ignored by git) and fill in your broker.
// Any MQTT broker with username/password and TLS works. Example for an EMQX
// Serverless deployment (free tier): the address and port are on its Overview
// page, users are added under Access Control -> Authentication.
// Use the same broker in the bot's environment (MQTT_HOST, MQTT_PORT, ...).
#define MQTT_BROKER   "abc123.ala.eu-central-1.emqxsl.com"
#define MQTT_PORT     8883  // TLS; EMQX Serverless only accepts TLS
#define MQTT_USER     "printer"
#define MQTT_PASSWORD "change-me"

// Optional: the broker's root CA certificate (PEM, from the EMQX Overview page).
// Without it the connection is still encrypted, but the broker's identity isn't
// verified. Keep the \n at the end of every line.
/*
#define MQTT_ROOT_CA \
    "-----BEGIN CERTIFICATE-----\n" \
    "<paste each line of the certificate like this>\n" \
    "-----END CERTIFICATE-----\n"
*/
